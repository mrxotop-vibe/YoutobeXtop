<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="760dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/card_bg"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập tài khoản (TV OAuth2)"
                android:textColor="@color/red"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/txt_step1_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1. Mở trình duyệt trên điện thoại và truy cập:\nhttps://www.google.com/device"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Nhập mã dưới đây trên điện thoại:"
                android:textColor="#E0E0E0"
                android:textSize="17sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_device_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#101010"
                android:padding="18dp"
                android:text="Đang tạo mã..."
                android:textColor="@color/white"
                android:textSize="42sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:letterSpacing="0.12"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/txt_login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Đang kết nối Google OAuth..."
                android:textColor="#FFD54F"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_refresh_code"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Lấy mã mới"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_focus_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="10dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_custom_client"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Nhập Client ID riêng"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_focus_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="10dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Đăng xuất"
                    android:textAllCaps="false"
                    android:textColor="#FF8A80"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_focus_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="10dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Quay lại"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_focus_selector"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
