<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/card_bg"
        android:padding="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng nhập tài khoản (TV OAuth2)"
            android:textColor="@color/red"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txt_step1_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1. Mở trình duyệt trên điện thoại và truy cập:\nhttps://www.google.com/device"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Nhập mã dưới đây trên điện thoại:"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txt_device_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#101010"
            android:padding="16dp"
            android:text="Đang tạo mã..."
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:letterSpacing="0.12"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txt_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Đang kết nối Google OAuth..."
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_refresh_code"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Lấy mã mới"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/card_focus_selector"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_custom_client"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Nhập Client ID riêng"
                android:textAllCaps="false"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:background="@drawable/card_focus_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="#FF8A80"
                android:textSize="13sp"
                android:background="@drawable/card_focus_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Quay lại"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/card_focus_selector"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
