<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="760dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Cài đặt SmartXtop (Tối ưu cho TV &amp; Android 5.1)"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btn_setting_quality"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Chất lượng ưu tiên: 1080p Full HD (Nét nhất)"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:background="@drawable/sidebar_item_selector"
                android:layout_marginBottom="10dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_setting_sponsorblock"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="SponsorBlock (Tự bỏ qua tài trợ/intro): BẬT ✓"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:background="@drawable/sidebar_item_selector"
                android:layout_marginBottom="10dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_setting_dearrow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="DeArrow (Làm sạch tiêu đề giật tít): BẬT ✓"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:background="@drawable/sidebar_item_selector"
                android:layout_marginBottom="10dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_setting_autonext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Tự động phát video tiếp theo: BẬT ✓"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:background="@drawable/sidebar_item_selector"
                android:layout_marginBottom="10dp"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Xóa lịch sử &amp; Cache"
                    android:textAllCaps="false"
                    android:textColor="#FF8A80"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_focus_selector"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginEnd="12dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_settings_back"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Đóng"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_focus_selector"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
