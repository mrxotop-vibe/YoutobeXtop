<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Cài đặt SmartXtop (Tối ưu Android 5.1)"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_setting_quality"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Chất lượng mặc định: 720p MP4 (Mượt cho 5.1)"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_setting_sponsorblock"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="SponsorBlock (Bỏ qua quảng cáo/tài trợ trong video): BẬT"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_setting_dearrow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="DeArrow (Làm sạch tiêu đề giật tít - TizenCobalt mod): BẬT"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_setting_autonext"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Tự động chuyển sang video tiếp theo khi hết: BẬT"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Xóa lịch sử &amp; Cache"
                android:textAllCaps="false"
                android:textColor="#FF8A80"
                android:textSize="13sp"
                android:background="@drawable/card_focus_selector"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="10dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_settings_back"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Đóng"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/card_focus_selector"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
